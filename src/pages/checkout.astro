---
// Import your site's main layout so headers/footers match
import Layout from '../layouts/Layout.astro';

const xymoulisFee = 2.50;
---

<Layout title="Checkout | Answer Desk Checkout">
  <main class="checkout-container">
    <h1>⚖️Answer Desk Checkout</h1>
    <p class="subtitle">Almost there...</p>

    <div class="order-summary">
      <div class="summary-row">
        <span>Base Fee</span>
        <span id="display-base-fee">1,00 €</span>
      </div>
      <div class="summary-row">
        <span>Xymoulis Refill Fee</span>
        <span>2.50 €</span>
      </div>
      <hr />
      <div class="summary-row total">
        <strong>Total Due Today</strong>
        <strong id="display-total">3,50 €</strong>
      </div>
    </div>

    <!-- Joke Payment Form -->
    <form id="joke-payment-form" onsubmit="event.preventDefault(); handleJokePayment();">
      <div class="field">
        <label for="cardholder">Cardholder Name</label>
        <input type="text" id="cardholder" placeholder="e.g. Dua Lipa" required />
      </div>

      <div class="field">
        <label for="cardnum">Credit Card Number</label>
        <input type="text" id="cardnum" placeholder="4242 •••• •••• 4242" maxlength="19" required />
      </div>

      <div class="field-row">
        <div class="field">
          <label for="exp">Expiry</label>
          <input type="text" id="exp" placeholder="MM/YY" required />
        </div>
        <div class="field">
          <label for="cvv">CVV</label>
          <input type="text" id="cvv" placeholder="404" required />
        </div>
      </div>

      <div class="center">
        <img class="pro-img" src="/images/tha-plirotho.jpeg" alt="First Image" width="400px" height="281" loading="lazy" decoding="async">
      </div>

      <button type="submit" class="pay-button">Pay 🥺 💳 ❤️</button>
    </form>
  </main>
</Layout>

<script is:inline>
  // 1. Read ?fee= from the browser URL dynamically on load
  const params = new URLSearchParams(window.location.search);
  const rawFee = params.get('fee') || '1';
  const baseFee = parseFloat(rawFee) || 1;
  const xymoulisFee = 2.50;
  const grandTotal = baseFee + xymoulisFee;

  // 2. Format numbers to European standard (de-DE)
  const formattedBaseFee = baseFee.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const formattedTotal = grandTotal.toLocaleString('de-DE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

  // 3. Inject them directly into the HTML page elements
  document.getElementById('display-base-fee').innerText = formattedBaseFee + ' €';
  document.getElementById('display-total').innerText = formattedTotal + ' €';
  document.getElementById('pay-btn').innerText = `Pay ${formattedTotal} € Now 💳`;

  // 4. Joke payment handler using the dynamic total
  function handleJokePayment() {
    const cardName = document.getElementById('cardholder').value || 'Friend';
    
    const jokes = [
      `DECLINED: Sorry, ${cardName}! Try again. Make sure to have money before you pay. 🙄`,
      `PROCESSING... Error 402: Payment Required. What did you do wrong?`,
      `SUCCESS! Your payment of ${formattedTotal} € was successfully billed! 🎉`
    ];

    const randomJoke = jokes[Math.floor(Math.random() * jokes.length)];
    alert(randomJoke);
  }
</script>

<style>
  .checkout-container {
    width: 100%;
    max-width: 500px;
    margin: 1.5rem auto;
    padding: 1.5rem;
    box-sizing: border-box; /* Prevents padding from blowing out screen width */
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    font-family: inherit;
  }

  .order-summary {
    background: rgba(255, 255, 255, 0.05);
    padding: 1rem;
    border-radius: 8px;
    margin: 1.5rem 0;
  }

  .summary-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.5rem;
    gap: 1rem; /* Prevents text from overlapping on tiny screens */
    word-break: break-word;
  }

  .total {
    font-size: 1.2rem;
    color: #ff6b6b;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .field-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap; /* Automatically stacks Expiry and CVV on narrow mobile screens */
  }

  .field {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 120px; /* Ensures inputs don't shrink into nothingness */
  }

  label {
    font-size: 0.85rem;
    margin-bottom: 0.25rem;
  }

  input {
    width: 100%;
    padding: 0.75rem; /* Slightly taller for easier mobile tapping */
    border-radius: 6px;
    border: 1px solid #444;
    background: #111;
    color: #fff;
    box-sizing: border-box;
    font-size: 1rem; /* Prevents iOS auto-zoom on input focus */
  }

  .pay-button {
    margin-top: 1rem;
    padding: 0.9rem;
    background-color: #6366f1;
    color: white;
    border: none;
    border-radius: 6px;
    font-weight: bold;
    cursor: pointer;
    font-size: 1rem;
  }

  .pay-button:hover {
    background-color: #4f46e5;
  }

  /* Extra safety check for very small mobile devices */
  @media (max-width: 480px) {
    .checkout-container {
      margin: 0.5rem auto;
      padding: 1rem;
      border-left: none;
      border-right: none;
      border-radius: 0;
    }
  }
</style>