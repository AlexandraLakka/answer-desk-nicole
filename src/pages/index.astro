---
import Layout from '../layouts/Layout.astro';
const pageTitle = "Answer Desk";
---
<Layout pageTitle={pageTitle}>
    <div class="gif">
        <img src="/images/space.webp" role="presentation" width="300" height="259" decoding="async">
    </div>
    <h1>Answer Desk</h1>
    <span class="badge">Nicole Lakka (Adekastos lawyer)</span>
    <h2>About</h2>
    <p>
        Hello friend! This is a personal site to help automate and better respond to any questions or requests you might
        have. The demand has seen an exponential increase, so I believe the options here can better guide you
        and help our cooperation! I am really excited to share this new endeavour with you!
    </p>

    <div class="center">
        <img class="pro-img" src="/images/tremo.jpg" alt="First Image" width="500px" height="281" loading="lazy" decoding="async">
    </div>

    <div class="center">
        <a href="/posts/">
            <button class="btn">Options</button>
        </a>
    </div>
</Layout>

